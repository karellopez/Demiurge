{
  "name": "demiurge",
  "version": "0.1.0",
  "private": true,
  "description": "A physically grounded, browser-based solar system simulator with a flyable ship, seamless planetary landing, and an explorable surface sandbox.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@10.9.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karellopez/Demiurge.git"
  },
  "homepage": "https://karellopez.github.io/Demiurge/",
  "bugs": {
    "url": "https://github.com/karellopez/Demiurge/issues"
  },
  "keywords": [
    "solar-system",
    "webgl2",
    "three.js",
    "simulation",
    "astronomy",
    "procedural-generation"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project=unit --project=integration --project=perf",
    "test:watch": "vitest --project=unit --project=integration",
    "test:coverage": "vitest run --project=unit --project=integration --project=perf --coverage",
    "test:e2e": "playwright test --project=smoke",
    "test:visual": "playwright test --project=visual",
    "bench": "vitest bench --run --project=bench",
    "bench:flythrough": "tsx --tsconfig tsconfig.node.json scripts/bench-flythrough.ts",
    "mutation": "stryker run",
    "depcruise": "depcruise src scripts --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot",
    "knip": "knip",
    "jscpd": "jscpd",
    "size": "size-limit",
    "audit:licenses": "license-checker-rseidelsohn --production --onlyAllow \"MIT;MIT OR X11;ISC;BSD;BSD-2-Clause;BSD-3-Clause;Apache-2.0;CC0-1.0;Unlicense;0BSD;Python-2.0;BlueOak-1.0.0\" --excludePrivatePackages",
    "qa": "tsx --tsconfig tsconfig.node.json scripts/qa-report.ts",
    "verify": "npm run typecheck && npm run lint && npm run validate:data && npm run test:coverage && npm run build && npm run qa",
    "assets:fetch": "tsx --tsconfig tsconfig.node.json scripts/fetch-assets.ts",
    "build:textures": "tsx --tsconfig tsconfig.node.json scripts/build-textures.ts",
    "fixtures:horizons": "tsx --tsconfig tsconfig.node.json scripts/fetch-horizons-fixtures.ts",
    "validate:data": "tsx --tsconfig tsconfig.node.json scripts/validate-data.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.19.1",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "^8.20.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.3.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "74.0.0",
    "fast-check": "4.9.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "jscpd": "5.1.0",
    "knip": "6.33.0",
    "license-checker-rseidelsohn": "4.4.2",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
